# Unité systemd — agent vocal LiveKit (process séparé de l'API).
#
# Rejoint la room LiveKit dans laquelle le navigateur du téléphone publie son
# micro. Aucun périphérique audio n'est utilisé sur le Pi.
[Unit]
Description=Assistant — agent vocal LiveKit
After=network-online.target crush-api.service
Wants=network-online.target
# `Wants` et non `Requires` : si l'agent vocal tombe, l'assistant doit rester
# joignable en texte. La voix est un confort, pas le socle.
Wants=crush-api.service

# StartLimit* appartient à [Unit] — cf. commentaire dans crush-api.service.
StartLimitBurst=5
StartLimitIntervalSec=300

[Service]
Type=exec
User=__CRUSH_USER__
WorkingDirectory=__CRUSH_DIR__

ExecStart=__CRUSH_DIR__/.venv/bin/python -m crush.interfaces.voice.agent dev

Environment=PATH=__CRUSH_DIR__/.venv/bin:/usr/local/bin:/usr/bin:/bin
Environment=PYTHONUNBUFFERED=1
Environment=PYTHONUTF8=1
# Coupe les avertissements de dépréciation des plugins LiveKit, qui noient
# les vraies erreurs dans journalctl.
Environment=PYTHONWARNINGS=ignore

Restart=always
RestartSec=5

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full

[Install]
WantedBy=multi-user.target
